# Wamp root
/alias
/apps
/bin
/cgi-bin
/files
/lang
/logs
/save
/scripts
/tmp
/www
/*.txt
/*.bmp
/*.bat
/*.msg
/unins000.*
/wampmanager.*
/vendor

# dotenv environment variable files
_env
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# apps
# /apps/adminer*
# /apps/phpsysinfo*
