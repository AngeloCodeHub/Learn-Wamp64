# bin/MariaDB
# /bin/MariaDB

# bin/Apache/
# /bin/apache/*/*
# /bin/apache/*/conf/original
# !/bin/apache/*/conf
# /bin/apache/modules_sup
# /bin/apache/*/*.*

# bin/MySQL
# /bin/mysql/*/*
# !/bin/mysql/*/my.ini

# bin/PHP
# /bin/php/DO_NOT_DELETE_*
# /bin/php/*/*
# !/bin/php/*/php.ini*
# !/bin/php/*/phpForApache.ini
